{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSimemBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::eafit-proyecto-integrador-simem"
      ]
    },
    {
      "Sid": "AllowSimemBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::eafit-proyecto-integrador-simem/bronze",
        "arn:aws:s3:::eafit-proyecto-integrador-simem/bronze_$folder$",
        "arn:aws:s3:::eafit-proyecto-integrador-simem/bronze/*",
        "arn:aws:s3:::eafit-proyecto-integrador-simem/silver",
        "arn:aws:s3:::eafit-proyecto-integrador-simem/silver_$folder$",
        "arn:aws:s3:::eafit-proyecto-integrador-simem/silver/*",
        "arn:aws:s3:::eafit-proyecto-integrador-simem/gold",
        "arn:aws:s3:::eafit-proyecto-integrador-simem/gold_$folder$",
        "arn:aws:s3:::eafit-proyecto-integrador-simem/gold/*",
        "arn:aws:s3:::eafit-proyecto-integrador-simem/glue",
        "arn:aws:s3:::eafit-proyecto-integrador-simem/glue_$folder$",
        "arn:aws:s3:::eafit-proyecto-integrador-simem/glue/*"
      ]
    }
  ]
}
